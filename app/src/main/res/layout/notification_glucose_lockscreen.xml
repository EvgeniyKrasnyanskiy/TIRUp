<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_lockscreen_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Row 1: Large Glucose + Arrow + Delta + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_glucose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.4"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="↗"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Δ +0.2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#94A3B8" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19:49"
            android:textSize="12sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Row 2: Metrics Chips (TIR, IoB, CoB) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_tir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIR: 97%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#10B981" />

        <TextView
            android:id="@+id/notif_dot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="•"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/notif_iob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💉 1.07 Ед"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8" />

        <TextView
            android:id="@+id/notif_dot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="•"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/notif_cob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍞 3 г"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FBBF24" />
    </LinearLayout>
</LinearLayout>
