<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_alert_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Left Content Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_alert_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔺 Высокий сахар (подтверждено)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F59E0B"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_alert_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Глюкоза: 10.0 ммоль/л выше нормы 8.0."
            android:textSize="13sp"
            android:textColor="#E2E8F0"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Always Visible OK Action Button on the Right -->
    <TextView
        android:id="@+id/notif_alert_ok_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/notification_button_ok"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="ОК"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />
</LinearLayout>
