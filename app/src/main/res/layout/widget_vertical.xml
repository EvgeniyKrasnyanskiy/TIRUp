<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <!-- 1. Glucose Value + Stacked [ Arrow / Delta ] in one row -->
    <LinearLayout
        android:id="@+id/widget_glucose_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="4.7"
            android:textColor="#10B981"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_trend_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="↑"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_delta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="-0.8"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Divider Line -->
    <FrameLayout
        android:id="@+id/widget_horizontal_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:background="#26FFFFFF" />

    <!-- 2. TIR: 93% -->
    <TextView
        android:id="@+id/widget_tir_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:text="TIR: 93%"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- 3. +3ч 45м (Compensator) -->
    <TextView
        android:id="@+id/widget_compensator_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:text="+3ч 45м"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 4. IoB (💉 0.7 U) -->
    <TextView
        android:id="@+id/widget_iob_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:text="💉 0.7 U"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 5. Streak (🔥 4 д.) -->
    <TextView
        android:id="@+id/widget_streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:text="🔥 4 д."
        android:textColor="#F59E0B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 6. Master Battery (🔋 19%) -->
    <TextView
        android:id="@+id/widget_master_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:text="🔋 19%"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Flexible Bottom Spacer -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 7. Mini Horizontal TIR Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_tir_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="1dp"
        android:max="100"
        android:progress="85"
        android:progressBackgroundTint="#2E3A4B"
        android:progressTint="#10B981" />

    <!-- Dummy hidden views -->
    <TextView
        android:id="@+id/widget_time_ago"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
