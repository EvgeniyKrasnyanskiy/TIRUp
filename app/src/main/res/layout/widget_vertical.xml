<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top: Daily Compensator Balance Badge (+1ч 34м) -->
    <TextView
        android:id="@+id/widget_compensator_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="+1ч 34м"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Dummy hidden time_ago for safety -->
    <TextView
        android:id="@+id/widget_time_ago"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Flexible Top Spacer -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center: Large Glucose Value + Stacked [ Arrow / Delta ] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="9.1"
            android:textColor="#10B981"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_trend_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="→"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_delta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="+0.2"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Streak Badge -->
    <TextView
        android:id="@+id/widget_streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:text="🔥 5 д."
        android:textColor="#F59E0B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Active Insulin (IoB) Badge -->
    <TextView
        android:id="@+id/widget_iob_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="💉 1.2 U"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Flexible Bottom Spacer -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: TIR Focus Badge -->
    <TextView
        android:id="@+id/widget_tir_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="TIR: 100%"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Mini Horizontal TIR Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_tir_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progress="85"
        android:progressBackgroundTint="#2E3A4B"
        android:progressTint="#10B981" />

</LinearLayout>
