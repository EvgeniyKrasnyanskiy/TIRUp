<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="7dp">

    <!-- Top: Timestamp or time-ago indicator -->
    <TextView
        android:id="@+id/widget_time_ago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:text="12:45"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <!-- Flexible Top Spacer -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center: Large Glucose Value + Trend Arrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="9.1"
            android:textColor="#10B981"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_trend_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="2dp"
            android:text="→"
            android:textColor="#10B981"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Trend Delta (e.g. -0.4) -->
    <TextView
        android:id="@+id/widget_delta_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:text="+0.2"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Streak Badge -->
    <TextView
        android:id="@+id/widget_streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:text="🔥 5 д."
        android:textColor="#F59E0B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Active Insulin (IoB) Badge -->
    <TextView
        android:id="@+id/widget_iob_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="💉 1.2 U"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Flexible Bottom Spacer -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: TIR Focus Badge -->
    <TextView
        android:id="@+id/widget_tir_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_bg"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="TIR: 100%"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Mini Horizontal TIR Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_tir_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progress="85"
        android:progressBackgroundTint="#2E3A4B"
        android:progressTint="#10B981" />

</LinearLayout>
