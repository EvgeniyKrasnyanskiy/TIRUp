<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Metrics & Quick Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Glucose & Trend -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_glucose_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6.4"
                android:textColor="#10B981"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_trend_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="→"
                android:textColor="#10B981"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_delta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.3"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2м назад"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Streak Badge -->
        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="🔥 4 дн"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- IoB Badge -->
        <TextView
            android:id="@+id/widget_iob_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="💉 1.2 U"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Nightstand Action Button -->
        <TextView
            android:id="@+id/widget_btn_nightstand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="🌙"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Middle: Sparkline Chart (3-4 hours trajectory with TIR band) -->
    <ImageView
        android:id="@+id/widget_chart_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:contentDescription="Glucose Sparkline Chart"
        android:scaleType="fitXY" />

    <!-- Bottom: Daily Compensator Goal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_tir_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="TIR за сегодня: 82%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_compensator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="В норме ещё 2 ч 15 мин"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/widget_tir_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="82"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>

</LinearLayout>
