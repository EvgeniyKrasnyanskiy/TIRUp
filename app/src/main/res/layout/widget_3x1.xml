<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- 1. Left: Glucose, Arrow, Delta, Time -->
    <LinearLayout
        android:id="@+id/widget_glucose_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.4"
            android:textColor="#10B981"
            android:textSize="26sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_trend_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:text="↗"
            android:textColor="#10B981"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_delta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.2"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2м"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:visibility="gone"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Right: TIR Badge + IoB/CoB Layout -->
    <LinearLayout
        android:id="@+id/widget_right_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <!-- IoB & CoB -->
        <LinearLayout
            android:id="@+id/widget_iob_cob_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_iob_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="💉 1.2 U"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_cob_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="🍞 25 g"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- TIR score badge -->
        <TextView
            android:id="@+id/widget_tir_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="TIR: 97%"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

</RelativeLayout>
