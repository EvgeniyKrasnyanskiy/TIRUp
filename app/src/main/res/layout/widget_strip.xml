<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- 1. Left: Glucose Value + Stacked [ Arrow / Delta ] -->
    <LinearLayout
        android:id="@+id/widget_glucose_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="9.1"
            android:textColor="#10B981"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_trend_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="→"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_delta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="+0.3"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <FrameLayout
        android:id="@+id/widget_divider"
        android:layout_width="1dp"
        android:layout_height="26dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#26FFFFFF" />

    <!-- 2. Middle 1: Stacked [ TIR / Compensator ] in 2 rows + Progress Bar -->
    <LinearLayout
        android:id="@+id/widget_compensator_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|start"
        android:orientation="vertical">

        <!-- Row 1: TIR Score Badge -->
        <TextView
            android:id="@+id/widget_tir_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="TIR: 78%"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Row 2: Daily Compensator Balance Badge -->
        <TextView
            android:id="@+id/widget_compensator_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="+1ч 45м"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Row 3: Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_tir_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="78"
            android:progressBackgroundTint="#2E3A4B"
            android:progressTint="#10B981" />
    </LinearLayout>

    <!-- 3. Middle 2: Ranges [ TBR / TAR ] in 2 rows -->
    <LinearLayout
        android:id="@+id/widget_stats_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="center_vertical|start"
        android:orientation="vertical">

        <!-- Line 1: Time Below Range (TBR: 2%) -->
        <TextView
            android:id="@+id/widget_tbr_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="TBR: 2%"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Line 2: Time Above Range (TAR: 18%) -->
        <TextView
            android:id="@+id/widget_tar_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="TAR: 18%"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Right Column 1: Stacked [ IoB / Streak / Fallback ] in 2 rows -->
    <LinearLayout
        android:id="@+id/widget_iob_streak_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Line 1: IoB / Fallback Slot 1 -->
        <TextView
            android:id="@+id/widget_iob_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="💉 1.2 U"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Line 2: Streak / Fallback Slot 2 -->
        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="🔥 5 д."
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. Right Column 2: Stacked [ Battery / Time Ago / Fallback ] in 2 rows -->
    <LinearLayout
        android:id="@+id/widget_battery_time_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Line 1: Battery / Fallback Slot 3 (Mean BG) -->
        <TextView
            android:id="@+id/widget_master_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="Ср: 7.4"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <!-- Line 2: Time Ago / Fallback Slot 4 (CV%) -->
        <TextView
            android:id="@+id/widget_time_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:text="CV: 28%"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <!-- 5. Sparkline Chart removed on 5x1 strip to keep 5 main columns uncompressed -->
    <ImageView
        android:id="@+id/widget_chart_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Dummy views for compatibility -->
    <LinearLayout
        android:id="@+id/widget_iob_cob_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_cob_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
