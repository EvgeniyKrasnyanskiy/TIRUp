<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top: Time indicator if stale (hidden if <= 1m) -->
    <TextView
        android:id="@+id/widget_time_ago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5м"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- Glucose Value + Trend Arrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glucose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9.1"
            android:textColor="#3B82F6"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_trend_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:text="→"
            android:textColor="#3B82F6"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom: TIR Focus Badge -->
    <TextView
        android:id="@+id/widget_tir_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_badge_bg"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="TIR 100%"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Optional Delta Value (hidden when TIR is visible) -->
    <TextView
        android:id="@+id/widget_delta_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+0.2"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:visibility="gone" />

</LinearLayout>
