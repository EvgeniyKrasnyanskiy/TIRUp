<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Permits cleartext HTTP for local LAN xDrip+ follow server and user micro-servers, trusting system & user CAs -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
