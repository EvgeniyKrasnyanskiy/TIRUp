<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.eveningoutpost.dexdrip" />
        <package android:name="de.michelinside.glucodatahandler" />
        <package android:name="tk.glucodata" />
        <package android:name="com.diaclock.nightstand" />
        <intent>
            <action android:name="com.eveningoutpost.dexdrip.BgEstimate" />
        </intent>
        <intent>
            <action android:name="glucodata.Minute" />
        </intent>
    </queries>

    <application
        android:name=".TirupApplication"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TIRUp">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver for xDrip+ / Juggluco / Nightscout / GlucoDataHandler local broadcasts -->
        <receiver
            android:name=".data.receiver.DexdripBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eveningoutpost.dexdrip.BgEstimate" />
                <action android:name="com.eveningoutpost.dexdrip.BgEstimate.NEW_DATA" />
                <action android:name="com.eveningoutpost.dexdrip.ACTION_NEW_BG_ESTIMATE" />
                <action android:name="com.eveningoutpost.dexdrip.ACTION_NEW_BG" />
                <action android:name="glucodata.Minute" />
                <action android:name="de.michelinside.glucodatahandler.GLUCODATA" />
                <action android:name="de.michelinside.glucodatahandler.MINUTE" />
                <action android:name="info.nightscout.android.NEW_SGV" />
                <action android:name="info.nightscout.android.EXTRA_DATA" />
                <action android:name="com.juggluco.action.NEW_GLUCOSE" />
                <action android:name="com.dexcom.g6.ACTION_NEW_BG" />
                <action android:name="com.dexcom.cgm.ACTION_NEW_BG" />
                <action android:name="com.eveningoutpost.dexdrip.watch.wearintegration.BROADCAST_SERVICE_SENDER" />
                <action android:name="info.nightscout.androidaps.status" />
            </intent-filter>
        </receiver>

        <!-- Receiver for daily exact 23:59:59 auto-backup alarm -->
        <receiver
            android:name=".data.receiver.BackupAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Receiver for critical alarm notification actions (e.g. Dismiss) -->
        <receiver
            android:name=".data.receiver.AlertActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tirup.app.ACTION_DISMISS_CRITICAL" />
            </intent-filter>
        </receiver>

        <!-- Floating Glucose Bubble Overlay Service -->
        <service
            android:name=".presentation.overlay.FloatingBubbleService"
            android:exported="false" />

        <!-- FileProvider for secure offline sharing of generated PDF medical reports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- AppWidget Provider: 4x1 ↔ 5x1 Glycemic Strip -->
        <receiver
            android:name=".presentation.widget.TirupStripWidgetProvider"
            android:exported="true"
            android:label="@string/widget_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strip_info" />
        </receiver>

        <!-- AppWidget Provider: 4x2 ↔ 5x2 Bento Dashboard -->
        <receiver
            android:name=".presentation.widget.TirupDashboardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_dashboard_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_info" />
        </receiver>

        <!-- AppWidget Provider: 2x2 Compact Focus -->
        <receiver
            android:name=".presentation.widget.TirupCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- AppWidget Provider: 1x1 Minimal Glance -->
        <receiver
            android:name=".presentation.widget.TirupMiniWidgetProvider"
            android:exported="true"
            android:label="@string/widget_minimal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_info" />
        </receiver>

        <!-- AppWidget Provider: 1x2 Vertical Glance -->
        <receiver
            android:name=".presentation.widget.TirupVerticalWidgetProvider"
            android:exported="true"
            android:label="@string/widget_vertical_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vertical_info" />
        </receiver>

        <!-- AppWidget Provider: 3x2 Compact Dashboard -->
        <receiver
            android:name=".presentation.widget.TirupMediumWidgetProvider"
            android:exported="true"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_medium_info" />
        </receiver>
    </application>

</manifest>
